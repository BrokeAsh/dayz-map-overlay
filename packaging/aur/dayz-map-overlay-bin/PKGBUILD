# Maintainer: BrokeAsh <158607416+BrokeAsh@users.noreply.github.com>

pkgname=dayz-map-overlay-bin
_name=dayz-map
pkgver=0.3.1
pkgrel=1
pkgdesc="See-through DayZ map that opens over the game and follows the server you're on"
arch=('x86_64')
url="https://github.com/BrokeAsh/dayz-map-overlay"
license=('MIT' 'Apache-2.0')
# A Wayland layer-shell window drawn through EGL (KDE Plasma 6, Sway, Hyprland).
depends=('gcc-libs' 'glibc' 'libglvnd' 'libxkbcommon' 'wayland')
provides=('dayz-map-overlay')
conflicts=('dayz-map-overlay')
options=('!strip' '!debug')
source=("$url/releases/download/v$pkgver/$_name-v$pkgver-linux-x86_64.tar.gz")
sha256sums=('ab531209ba6fc33bb56ca4460855254a6ef02c1e5d8559805371eeb6fc6dbb9b')

package() {
  cd "$_name-v$pkgver-linux-x86_64"
  install -Dm755 -t "$pkgdir/usr/bin" dayz-map
  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md CHANGELOG.md
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE-MIT LICENSE-APACHE
}
